---
import Layout from "@/layouts/main.astro";
import { BirthdayCardGenerator } from "@/components/BirthdayCardGenerator";
---

<Layout title="Birthday Bash Card Maker">
  <main class="relative min-h-screen overflow-hidden px-4 py-10 sm:py-16">
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-br from-sky-100 via-blue-50 to-indigo-100"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,oklch(0.78_0.14_240/0.35),transparent_42%),radial-gradient(circle_at_85%_15%,oklch(0.82_0.12_255/0.3),transparent_38%),radial-gradient(circle_at_60%_90%,oklch(0.75_0.1_270/0.25),transparent_45%)]"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute -top-8 left-[8%] size-3 rounded-full bg-sky-400/60"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute top-[18%] right-[12%] size-2 rounded-full bg-blue-500/50"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute bottom-[22%] left-[18%] size-2.5 rounded-full bg-indigo-400/45"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute bottom-[30%] right-[20%] size-1.5 rounded-full bg-cyan-400/55"
      aria-hidden="true"
    />
    <BirthdayCardGenerator client:load />
    <footer class="relative mt-12 text-center text-sm text-muted-foreground">
      <p>Made with too much cake and questionable humor.</p>
    </footer>
  </main>
</Layout>
