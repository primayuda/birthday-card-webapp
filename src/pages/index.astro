---
import Layout from "@/layouts/main.astro";
import FloatingBackground from "@/components/FloatingBackground.astro";
import { BirthdayCardGenerator } from "@/components/BirthdayCardGenerator";
---

<Layout title="Birthday Bash Card Maker">
  <main class="relative min-h-[100dvh] overflow-x-hidden px-3 py-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] sm:px-4 sm:py-10 sm:pb-16">
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-br from-sky-100 via-blue-50 to-indigo-100 dark:from-slate-950 dark:via-blue-950 dark:to-indigo-950"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,oklch(0.78_0.14_240/0.35),transparent_42%),radial-gradient(circle_at_85%_15%,oklch(0.82_0.12_255/0.3),transparent_38%),radial-gradient(circle_at_60%_90%,oklch(0.75_0.1_270/0.25),transparent_45%)] dark:bg-[radial-gradient(circle_at_15%_20%,oklch(0.45_0.12_255/0.35),transparent_42%),radial-gradient(circle_at_85%_15%,oklch(0.4_0.1_270/0.3),transparent_38%),radial-gradient(circle_at_60%_90%,oklch(0.35_0.08_240/0.25),transparent_45%)]"
      aria-hidden="true"
    />
    <FloatingBackground />
    <div class="relative z-1">
    <BirthdayCardGenerator client:load />
    <footer class="relative mt-12 text-center text-sm text-muted-foreground">
      <p>Made with too much cake and questionable humor.</p>
      <p class="mt-2">
        <a
          href="https://primayuda.dev"
          class="font-medium text-primary underline-offset-4 hover:underline"
        >
          @primayuda.dev
        </a>
      </p>
    </footer>
    </div>
  </main>
</Layout>
